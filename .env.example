# Horizon environment template.
# Copy to `.env.local` and fill in real values. Never commit real values.
#
# Nothing here is a secret that is safe to commit. The file lists NAMES only.
#
# TWO PROVIDERS, TWO CREDENTIALS
#   Generation (writing claims, verifying them) and embeddings (vector search)
#   are now separate concerns and may be different vendors. Each has its own
#   key. Do not put one vendor's key in the other's variable: it does not fail
#   loudly, it returns 401 from the wrong company and reads like an outage.

# --- Supabase (public; safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; NEVER expose to the browser or commit) ---
# Used only by server code. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- GENERATION provider (server-only) ---
# "groq" (default choice) or "google-genai". Anything else is reported as
# unrecognised rather than guessed at, and no generation call is possible.
HORIZON_LLM_PROVIDER=groq
# Endpoint base for the generation provider. Required in practice for an
# OpenAI-compatible provider: the documented Groq default below is applied when
# this is empty. It is NOT forwarded to the Google SDK, which serves embeddings.
HORIZON_LLM_BASE_URL=https://api.groq.com/openai/v1
# GENERATION credential. NEVER prefix with NEXT_PUBLIC_.
#   groq            -> your Groq API key.
#   google-genai    -> your Google key (GOOGLE_API_KEY / GEMINI_API_KEY are also
#                      accepted, because the Google SDK reads those names).
HORIZON_LLM_API_KEY=
# Answer-generation model. Recommended for groq: openai/gpt-oss-20b
# Recommended for google-genai: gemini-3.6-flash
HORIZON_LLM_MODEL=
# Optional reasoning hint. Supported values: low, medium, high. Empty sends
# nothing, leaving the model's own default. Lower values answer faster for less.
HORIZON_LLM_REASONING_EFFORT=

# --- EMBEDDINGS (server-only) ---
# The stored block vectors and the question vector MUST come from the same model
# and the same dimensionality, or similarity search is comparing two unrelated
# spaces and returns noise that still looks like a ranked list.
HORIZON_EMBEDDING_API_KEY=
# Recommended value shown; empty falls back to the same default.
HORIZON_EMBEDDING_MODEL=gemini-embedding-001
HORIZON_EMBEDDING_DIMENSIONS=768

# --- Guardrails ---
HORIZON_LLM_MAX_OUTPUT_TOKENS=4096
# Spend guard. This is ENFORCED, before the first provider request: 0 permits no
# call at all, so every turn refuses with BUDGET_EXHAUSTED and no embedding or
# generation request is sent. A configured deployment therefore still refuses
# until this is a positive number. Verify the live value through
# /api/v1/health/diagnostics (runtime.spendGuard) with the operator token; the
# public /api/v1/health intentionally does not publish it.
HORIZON_DAILY_TOKEN_BUDGET=0
# Per-request provider timeout in milliseconds.
HORIZON_LLM_TIMEOUT_MS=30000
# Ceiling on EMBEDDING REQUESTS per server process. The daily token budget above
# cannot meter embeddings, because that API reports no token usage — so this is a
# separate control on a different unit. 0 means "no cap configured". It bounds
# CALLS, not tokens or cost, so it is not a spending cap either.
HORIZON_MAX_EMBEDDING_CALLS=0
# Google-genai ONLY: reasoning-token budget. Ignored, and reported as ignored, by
# any other provider. Empty sends nothing. 0 disables thinking; -1 is automatic.
HORIZON_LLM_THINKING_BUDGET=

# --- Request admission ---
# Secret pepper for the question endpoint's rate-limit bucket key. The key is an
# HMAC of the client address and this value, scoped to one UTC day, so no IP
# address is ever stored. Empty derives a value from the service-role key. Set a
# long random string in production; rotating it resets the current windows.
HORIZON_RATE_LIMIT_SALT=

# --- Operator diagnostics ---
# Bearer token for GET /api/v1/health/diagnostics, which returns the detailed
# health report (provider, budget, ledger, schema). Empty makes the route answer
# 404, so an unconfigured deployment does not advertise it. This is an operator
# key, not user authentication, and it is never sent to a browser.
HORIZON_DIAGNOSTICS_TOKEN=
