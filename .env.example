[TEMPLATE]
# Horizon environment template.
# Copy to `.env.local` and fill in real values. Never commit real values.
#
# Nothing here is a secret that is safe to commit. The file lists NAMES only.

# --- Supabase (public; safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only; NEVER expose to the browser or commit) ---
# Used only by server code. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Horizon runtime AI provider (server-only) ---
# Provider: currently "google-genai" (official Google Gemini API via @google/genai).
# Leave blank until the free-tier data-use terms have been accepted by the team.
# With these blank the app reports "not configured" and refuses to answer; it never
# fabricates a result and never silently switches to paid inference.
HORIZON_LLM_PROVIDER=
# Server-side credential for the runtime provider. NEVER prefix with NEXT_PUBLIC_.
HORIZON_LLM_API_KEY=
# Answer-generation model. Recommended: gemini-3.6-flash
HORIZON_LLM_MODEL=
# Optional endpoint override. Empty means "use the SDK default endpoint", which is
# the normal case for the official SDK. This is NOT an OpenAI-compatible base URL.
HORIZON_LLM_BASE_URL=

# --- Embeddings (server-only) ---
# Stored block vectors and question vectors MUST use the same model and the same
# dimensionality, or the vector branch and its SQL function will disagree.
# Recommended value shown; empty falls back to the same default.
HORIZON_EMBEDDING_MODEL=gemini-embedding-001
HORIZON_EMBEDDING_DIMENSIONS=768

# --- Guardrails ---
HORIZON_LLM_MAX_OUTPUT_TOKENS=1024
# Spend guard. This is ENFORCED, before the first provider request: 0 permits no
# call at all, so every turn refuses with BUDGET_EXHAUSTED and no embedding or
# generation request is sent. A configured deployment therefore still refuses
# until this is a positive number. Verify the live value at /api/v1/health
# (runtime.spendGuard).
HORIZON_DAILY_TOKEN_BUDGET=0
# Per-request provider timeout in milliseconds.
HORIZON_LLM_TIMEOUT_MS=30000
# Ceiling on EMBEDDING REQUESTS per server process. The daily token budget above
# cannot meter embeddings, because that API reports no token usage — so this is a
# separate control on a different unit. 0 means "no cap configured". It bounds
# CALLS, not tokens or cost, so it is not a spending cap either.
HORIZON_MAX_EMBEDDING_CALLS=0
